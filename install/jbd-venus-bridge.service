[Unit]
Description=JBD BMS to Victron Venus OS MQTT bridge
Documentation=https://github.com/Ab0u/jbd_bms-victron-bridge
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/.venv/bin/python @REPO_DIR@/jbd_venus_mqtt.py
Restart=always
RestartSec=10
# Keep stdout/stderr in the journal
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@REPO_DIR@

[Install]
WantedBy=multi-user.target
